{
  "schemaVersion": 1,
  "recordTypes": {
    "demand": {
      "idPrefix": "DEM-",
      "required": ["id", "teamId", "title", "businessArea", "status", "priority", "service", "source", "triage", "workPackage", "deliverables"],
      "optional": ["forecast", "funding"],
      "forecastSemantics": {
        "rom": ["triage.romDays", "triage.romAmount"],
        "estimate": ["workPackage.executionEstimateDays", "workPackage.executionEstimateAmount"],
        "allocationStatus": "forecast.allocationStatus",
        "allocationStatusValues": ["Not Planned", "Partial", "Complete"],
        "currentForecastRule": "Complete allocations supersede Estimate amount; Estimate amount supersedes ROM amount"
      }
    },
    "team": {"idPrefix": "USR-", "required": ["id", "teamId", "name", "roleId", "fte", "active"]},
    "allocation": {"idPrefix": "ALLOC-", "required": ["id", "demandId", "teamMemberId", "forecast"]},
    "idea": {"idPrefix": "IDEA-", "required": ["id", "raisedBy", "raisedDate", "title", "description", "status"]},
    "statusReport": {
      "idPrefix": "SR-",
      "states": ["Draft", "Published", "Final"],
      "activeCycleFile": "status-reports/draft.json",
      "required": ["id", "status", "reportingDate", "entries"],
      "publishedRequired": ["publishedReportId", "publishedAt", "publishedBy"],
      "optional": ["previousReportId", "previousEntries", "revision", "modifiedAt", "modifiedBy", "finalizedAt", "finalizedBy", "unpublishedAt", "unpublishedBy"],
      "lifecycle": "Draft can be published and unpublished repeatedly. New Draft finalises the current Published report and starts the next Draft with previousReportId/previousEntries as its comparison baseline.",
      "draftConcurrency": "Optimistic three-way merge at status-report entry field level; conflicting edits to the same field require user reconciliation."
    }
  },
  "workspace": {"required": ["department"]},
  "config": {
    "required": ["teams", "roles"],
    "role": {"required": ["id", "name", "dayRate"]}
  }
}
