{
  "schemaVersion": 1,
  "recordTypes": {
    "demand": {
      "idPrefix": "DEM-",
      "required": ["id", "teamId", "title", "businessArea", "status", "priority", "service", "source", "triage", "workPackage", "deliverables"],
      "optional": ["forecast", "funding"],
      "forecastSemantics": {
        "rom": ["triage.romDays", "triage.romAmount"],
        "estimate": ["workPackage.executionEstimateDays", "workPackage.executionEstimateAmount"],
        "allocationStatus": "forecast.allocationStatus",
        "allocationStatusValues": ["Not Planned", "Partial", "Complete"],
        "currentForecastRule": "Complete allocations supersede Estimate amount; Estimate amount supersedes ROM amount"
      }
    },
    "team": {"idPrefix": "USR-", "required": ["id", "teamId", "name", "roleId", "fte", "active"]},
    "allocation": {"idPrefix": "ALLOC-", "required": ["id", "demandId", "teamMemberId", "forecast"]},
    "idea": {"idPrefix": "IDEA-", "required": ["id", "raisedBy", "raisedDate", "title", "description", "status"]},
    "statusReport": {"idPrefix": "SR-", "required": ["id", "status", "reportingDate", "publishedAt", "entries"]}
  },
  "workspace": {"required": ["department"]},
  "config": {
    "required": ["teams", "roles"],
    "role": {"required": ["id", "name", "dayRate"]}
  }
}
